# Copier ce fichier en `.env` pour le développement local et renseigner de
# vraies valeurs. Ne jamais committer de vraies valeurs (voir .gitignore).
# En production (Render), ces variables sont configurées directement dans
# le dashboard Render, pas via un fichier .env.

# ===== Environnement =====
# 'production' active les restrictions de sécurité (CORS strict, Swagger
# désactivé) — voir src/main.ts, src/config/cors.config.ts,
# src/config/swagger.config.ts.
NODE_ENV=development
PORT=3000

# ===== Base de données (Supabase Postgres) =====
DATABASE_URL=postgresql://user:password@host:5432/database

# ===== Authentification (JWT) =====
JWT_SECRET=change-me-to-a-long-random-string
# Durée de validité d'un jeton. Plus cette valeur est longue, plus un compte
# désactivé entre-temps reste valide côté JWT — la vérification `actif` se
# fait malgré tout à chaque requête (voir JwtStrategy), mais une durée plus
# courte reste une défense en profondeur supplémentaire.
JWT_EXPIRES_IN=7d

# ===== CORS =====
# Obligatoire en production (NODE_ENV=production) : liste d'origines
# autorisées séparées par des virgules, sans espace. Le serveur refuse de
# démarrer en production si cette variable est absente ou vide — jamais de
# repli automatique sur '*'.
CORS_ORIGINS=https://clinikdent-web.vercel.app

# ===== Administration plateforme =====
# Liste blanche d'e-mails (séparés par des virgules) autorisés à accéder aux
# routes /admin/* (comptes démo/permanents, liste de tous les cabinets).
# Tant que cette variable est absente, personne n'y a accès (fail-closed).
PLATFORM_ADMIN_EMAILS=admin@example.com

# ===== Stockage de fichiers patients (Supabase Storage) =====
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me
SUPABASE_STORAGE_BUCKET=patient-files

# ===== Paiement abonnement cabinet (Konnect, Tunisie) =====
KONNECT_API_KEY=change-me
KONNECT_WALLET_ID=change-me
# URL publique du frontend, utilisée pour construire les URLs de retour
# après paiement (succès/échec) et l'URL de webhook envoyée à Konnect.
APP_BASE_URL=https://clinikdent-web.vercel.app

# ===== SMS rappels manuels (WinSMS.tn) =====
WINSMS_API_KEY=change-me
WINSMS_DEFAULT_SENDER=ClinikDent

# ===== WhatsApp Business Cloud API (Meta) =====
# NON implémenté à ce jour (voir audit du 2026-09-05) : ces variables sont
# lues par WhatsAppService.isConfigured() mais aucun appel réel n'est encore
# fait vers l'API Meta. Placeholders documentés pour la Phase 3 à venir.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
